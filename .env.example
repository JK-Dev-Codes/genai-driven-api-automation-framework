# ──────────────────────────────────────────────
# Default Application Settings
# ──────────────────────────────────────────────
BASE_URL=https://your-api-base-url-here
TIMEOUT=30000

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info

# ──────────────────────────────────────────────
# OpenAI / Azure OpenAI (AI Parsing Layer)
# Set OPENAI_API_KEY to enable real AI parsing.
# Leave blank or set to "mock" for mock mode.
# ──────────────────────────────────────────────
OPENAI_API_KEY=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────────
# Multi-App Support Tokens
# ──────────────────────────────────────────────
CLIENT_API_TOKEN=your-client-app-token-here

# Active app profile (matches a file in src/config/apps/)
APP_NAME=default
