# ──────────────────────────────────────────────────────────────────────────────
# GenAI-Driven API Automation Framework — Environment Configuration
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application URLs ───────────────────────────────────────────────────────────
# BASE_URL    : The URL the browser opens to trigger your SSO login page
# API_BASE_URL: The base URL for all API calls (may differ from BASE_URL)
BASE_URL=https://your-app-login-url-here
API_BASE_URL=https://your-api-base-url-here
TIMEOUT=30000

# ── Logging ────────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info

# ── AI Engine (OpenAI) ─────────────────────────────────────────────────────────
# Set OPENAI_API_KEY to your real key to enable AI-driven test generation.
# Leave as "mock" to run in offline/demo mode (returns a fixed stub feature).
OPENAI_API_KEY=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Auth — Option A: Static Bearer token ──────────────────────────────────────
# Set CLIENT_API_TOKEN to a pre-obtained token.
# Leave SESSION_AUTH unset (commented out) to use this mode.
CLIENT_API_TOKEN=

# ── Auth — Option B: SSO browser login (auto-extracts token) ──────────────────
# The framework launches a headless browser, logs in, and extracts the token
# cookie automatically. Set SESSION_AUTH to any non-empty value to enable.
SESSION_AUTH=browser
USER_EMAIL=your-email@example.com
USER_PASSWORD=your-password

# SSO login page CSS selectors

# Override only if your login page uses different selectors.
SSO_EMAIL_SELECTOR=#login-username
SSO_NEXT_SELECTOR=#login-next
SSO_PASSWORD_SELECTOR=#login-password
SSO_SUBMIT_SELECTOR=#login-submit

# SSO_TWO_STEP=true   → email on page 1 (click Next), password on page 2
# SSO_TWO_STEP=false  → email + password on the same page
SSO_TWO_STEP=true

# Name of the cookie set by your SSO provider that holds the Bearer token
SSO_TOKEN_COOKIE_NAME=id_token

# Optional: element or URL to confirm successful login before extracting token
# SSO_SUCCESS_SELECTOR=.main-nav
# SSO_SUCCESS_URL_PATTERN=**/dashboard**

# ── App profile ────────────────────────────────────────────────────────────────
# Matches a config file in src/config/apps/<APP_NAME>.config.json
APP_NAME=default
